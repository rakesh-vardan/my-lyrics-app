# Neon connection strings. Easiest source: `neon link` (see README) pulls these
# into .env automatically. Or copy them from Project → Connect in the console.
#
# DATABASE_URL is the *pooled* string. The app queries over HTTPS through
# @neondatabase/serverless, so every function invocation reuses the pooler.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The *direct* (unpooled) string, used only by `npm run db:push` for DDL, because
# PgBouncer in transaction mode cannot run every migration statement.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional: the branch the CLI linked to (informational; nothing reads it at runtime).
# NEON_BRANCH="main"

# Password for the add/edit forms. Also signs the admin session cookie,
# so changing it invalidates every existing session.
# Use a long random value, e.g. `openssl rand -base64 24`.
ADMIN_PASSWORD="change-me"
